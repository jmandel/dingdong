<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DingDong" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerDropDownItem</item>
        <item name="android:spinnerItemStyle">@style/SpinnerItem</item>
    </style>

    <style name="SpinnerDropDownItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">#000000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">#000000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>