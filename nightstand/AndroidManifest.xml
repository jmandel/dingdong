<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jmandel.nightstand">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <!-- Read AntennaPod's database export in Documents; grant via
         adb shell appops set com.jmandel.nightstand MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- List paired headphones in settings. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Optional: lets the setup checklist fix the screensaver/low-light settings itself;
         adb shell pm grant com.jmandel.nightstand android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <package android:name="de.danoeh.antennapod" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_idle_alarm"
        android:theme="@android:style/Theme.DeviceDefault"
        android:allowBackup="false">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NightDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- Debug hook: adb shell am broadcast -n com.jmandel.nightstand/.DebugReceiver -a dump -->
        <receiver android:name=".DebugReceiver" android:exported="true" />
    </application>
</manifest>
